<Project>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Directory.Build.targets" />

  <Target Name="RedBoltCSGConfigureProjectReferences"
          BeforeTargets="AssignProjectConfiguration"
          DependsOnTargets="IncludeTransitiveProjectReferences">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="$([System.String]::Copy('%(ProjectReference.FullPath)').StartsWith('$(RedBoltRoot)/src/RedBolt/'))">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);RedBoltDearImGuiEnabled=true;RedBoltUtilityEnabled=true</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>
</Project>

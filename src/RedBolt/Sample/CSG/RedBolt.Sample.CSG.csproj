                      AdditionalProperties="RedBoltDearImGuiEnabled=true;RedBoltUtilityEnabled=true;RedBoltIKEnabled=true" />
    <Reference Include="RedBolt.Bindings.DearImGui" HintPath="$(RedBoltBaseDearImGuiBindingAssembly)" />
  </ItemGroup>
</Project>

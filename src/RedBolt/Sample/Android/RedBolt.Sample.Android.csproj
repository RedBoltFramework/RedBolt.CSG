<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- <redbolt-generated name="android-project-properties"> -->
    <AssemblyName>RedBolt.CSG.Sample.Android</AssemblyName>
    <ApplicationId>org.redbolt.csg.samples</ApplicationId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- </redbolt-generated name="android-project-properties"> -->
  </PropertyGroup>
  <ItemGroup>
    <!-- <redbolt-generated name="android-project-items"> -->
    <Compile Include="Program.cs" />
    <ProjectReference Include="../../CSG/RedBolt.CSG.csproj" />
    <ProjectReference Include="../../../../../RedBolt/src/RedBolt/DearImGui/RedBolt.DearImGui.csproj" />
    <Compile Include="../CSG/**/*.cs" Link="Samples/RedBoltCSG/CSG/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- </redbolt-generated name="android-project-items"> -->
  </ItemGroup>
  <!-- <redbolt-generated name="android-project-import"> -->
  <Import Project="../../../../../RedBolt/eng/RedBolt.ModuleBuild/AndroidSample.targets" />
  <!-- </redbolt-generated name="android-project-import"> -->
  <!-- <redbolt-generated name="android-project-targets"> -->
  <Target Name="RedBoltBuildAggregateAndroidNativeModules" BeforeTargets="RedBoltPrepareAndroidRuntime" Condition="'@(RedBoltAggregateAndroidNativeProject)' != ''">
    <MSBuild Projects="@(RedBoltAggregateAndroidNativeProject)" Targets="Restore;RedBoltPrepareAndroidRuntime" BuildInParallel="false"
             Properties="Configuration=$(Configuration);RedBoltBuildRoot=$(RedBoltBuildRoot);RedBoltExpectedBuildRoot=$(RedBoltExpectedBuildRoot);RedBoltParallelization=$(RedBoltParallelization);RedBoltPlatform=$(RedBoltPlatform);RuntimeIdentifier=$(RuntimeIdentifier);RedBoltBuildAllAndroidPackages=false;MSBuildEnableWorkloadResolver=false" />
  </Target>
  <!-- </redbolt-generated name="android-project-targets"> -->
</Project>

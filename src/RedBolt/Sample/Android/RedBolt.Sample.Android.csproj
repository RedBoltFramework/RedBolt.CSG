<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.CSG.Sample.Android</AssemblyName>
    <ApplicationId>org.redbolt.csg.samples</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../CSG/RedBolt.CSG.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/DearImGui/RedBolt.DearImGui.csproj" AdditionalProperties="RedBoltDearImGuiEnabled=true;RedBoltUtilityEnabled=true" />
    <Reference Include="RedBolt.Bindings.DearImGui" HintPath="$(RedBoltBaseDearImGuiBindingAssembly)" />
    <Compile Include="../CSG/**/*.cs" Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/AndroidSample.targets" />
</Project>

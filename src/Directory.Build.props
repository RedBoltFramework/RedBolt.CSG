<Project>
  <!--
    Module project evaluation. Managed-only module sharing the core repo's desktop data.
  -->
  <PropertyGroup>
    <RedBoltCSGRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RedBoltCSGRoot>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltCSGRoot)/../RedBolt'))</RedBoltRoot>
    <RedBoltExternalModuleRoot>$(RedBoltCSGRoot)</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.CSG</RedBoltExternalModuleName>
    <RedBoltExternalHasNative>false</RedBoltExternalHasNative>
    <RedBoltExternalDesktopResourceRoot>$(RedBoltRoot)</RedBoltExternalDesktopResourceRoot>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/Directory.Build.props" />
</Project>

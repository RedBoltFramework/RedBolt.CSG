<Project>
  <PropertyGroup>
    <RedBoltCSGRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RedBoltCSGRoot>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltCSGRoot)/../RedBolt'))</RedBoltRoot>
    <RedBoltDearImGuiEnabled>true</RedBoltDearImGuiEnabled>
    <RedBoltExternalModuleRoot>$(RedBoltCSGRoot)</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.CSG</RedBoltExternalModuleName>
    <RedBoltExternalBuildProjectName>RedBolt.CSG.Build</RedBoltExternalBuildProjectName>
    <RedBoltExternalModuleProjectNames>RedBolt.CSG</RedBoltExternalModuleProjectNames>
    <RedBoltExternalHasNative>false</RedBoltExternalHasNative>
    <RedBoltExternalUsesDearImGui>true</RedBoltExternalUsesDearImGui>
    <RedBoltExternalDesktopResourceRoot>$(RedBoltRoot)</RedBoltExternalDesktopResourceRoot>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Directory.Build.props" />
  <PropertyGroup>
    <RedBoltExternalModuleEnabled>$(RedBoltCSGEnabled)</RedBoltExternalModuleEnabled>
    <RedBoltExternalModuleBuildProperties>RedBoltCSGEnabled=$(RedBoltCSGEnabled)</RedBoltExternalModuleBuildProperties>
  </PropertyGroup>
</Project>

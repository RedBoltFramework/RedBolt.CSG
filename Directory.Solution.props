<Project>
  <PropertyGroup>
    <RedBoltCSGRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).'))</RedBoltCSGRoot>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltCSGRoot)/../RedBolt'))</RedBoltRoot>
    <RedBoltDearImGuiEnabled>true</RedBoltDearImGuiEnabled>
    <RedBoltExternalModuleRoot>$(RedBoltCSGRoot)</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.CSG</RedBoltExternalModuleName>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/ExternalModule/Directory.Solution.props" />
</Project>
